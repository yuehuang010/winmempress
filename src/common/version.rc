#include <windows.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION APP_VERSION_MAJOR,APP_VERSION_MINOR,APP_VERSION_PATCH,APP_VERSION_BUILD
 PRODUCTVERSION APP_VERSION_MAJOR,APP_VERSION_MINOR,APP_VERSION_PATCH,APP_VERSION_BUILD
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Felix Huang"
            VALUE "FileDescription", "MemPressMonitor"
            VALUE "ProductName", "MemPressMonitor"
            VALUE "FileVersion", MEMPRESS_VERSION_STRINGIZE(APP_VERSION_STRING)
            VALUE "ProductVersion", MEMPRESS_VERSION_STRINGIZE(APP_VERSION_STRING)
            VALUE "LegalCopyright", "(c) Felix Huang"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

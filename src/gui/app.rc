#include <windows.h>
#include "resource.h"

1 RT_MANIFEST "app.manifest"

IDI_APP ICON "app.ico"

IDD_MAIN DIALOGEX 0, 0, 260, 155
STYLE DS_SETFONT | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_THICKFRAME
CAPTION "MemPressMonitor"
FONT 9, "Segoe UI"
BEGIN
    CONTROL         "", IDC_APP_LIST, "SysListView32",
                    WS_TABSTOP | WS_VISIBLE | WS_CHILD | LVS_REPORT | LVS_SINGLESEL,
                    8, 8, 244, 110
    AUTOCHECKBOX    "Always on top", IDC_PIN_TOPMOST, 8, 128, 90, 20
    DEFPUSHBUTTON   "End Task", IDC_END_TASK, 162, 126, 90, 24
END
